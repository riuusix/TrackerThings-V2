# TrackerThings AI Microservice Environment Configuration
# Platform Target: Koyeb (Python 3.11+ / FastAPI / Uvicorn)

# Host and Port binding (Koyeb automatically injects $PORT in production)
HOST=0.0.0.0
PORT=8000

# Environment mode: development, staging, production
ENVIRONMENT=production

# Service-to-Service Shared Secret Key
# Incoming requests must supply:
# Header: "Authorization: Bearer <SERVICE_API_KEY>" OR "X-TrackerThings-Service-Key: <SERVICE_API_KEY>"
SERVICE_API_KEY=trackerthings_koyeb_service_secret_change_in_production

# Upload Constraints
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/jpg,image/webp

