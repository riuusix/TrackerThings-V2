# Environment variables template for TrackerThings Next.js

# PostgreSQL Database URL (Supabase, Neon, or Vercel Postgres)
# If using Supabase Connection Pooling (Transaction mode port 6543):
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
# DIRECT_URL is optional if using Supabase connection pooler for migrations
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# JWT Secret for Session Authentication (generate with `openssl rand -hex 32`)
JWT_SECRET="your-super-secret-jwt-key-replace-this-with-random-32-chars"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
