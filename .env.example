# Environment variables template for TrackerThings Next.js (Vercel & Local)

# 1. PostgreSQL Database URL (Supabase, Neon, or Vercel Postgres)
# Gunakan Supabase Transaction Connection Pooling (port 6543) untuk serverless Vercel:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# (Opsional) Direct connection (port 5432) jika menjalankan migrasi langsung:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# 2. Supabase API Configuration (digunakan oleh @supabase/ssr di server dan browser)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# 3. JWT Secret for Session Authentication (Wajib minimal 32 karakter di production, generate: openssl rand -hex 32)
JWT_SECRET="your-super-secret-jwt-key-replace-this-with-random-32-chars-minimum"

# 4. App URL (URL domain Vercel production atau http://localhost:3000 saat development)
NEXT_PUBLIC_APP_URL="https://[YOUR-PROJECT].vercel.app"
