generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int              @id @default(autoincrement())
  username           String           @unique
  password           String
  email              String           @unique
  fullName           String?          @map("full_name")
  phoneNumber        String?          @map("phone_number")
  profilePictureUrl  String?          @map("profile_picture_url")
  securityPrompt     String?          @map("security_prompt")
  securityAnswerHash String?          @map("security_answer_hash")
  role               String           @default("user")
  createdAt          DateTime         @default(now()) @map("created_at")
  profileUpdatedAt   DateTime?        @map("profile_updated_at")
  passwordChangedAt  DateTime?        @map("password_changed_at")

  jadwal             Jadwal[]
  tugas              Tugas[]
  ujian              Ujian[]
  kelasPengganti     KelasPengganti[]

  @@map("users")
}

model Jadwal {
  id             Int              @id @default(autoincrement())
  userId         Int              @map("user_id")
  namaMatkul     String           @map("nama_matkul")
  dosen          String?
  kategori       String?
  lokasi         String?
  sks            Int?
  hari           String
  waktuMulai     DateTime         @map("waktu_mulai") @db.Time
  waktuSelesai   DateTime         @map("waktu_selesai") @db.Time

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tugas          Tugas[]
  ujian          Ujian[]
  kelasPengganti KelasPengganti[]

  @@index([userId, hari, waktuMulai], map: "idx_jadwal_user_hari_waktu")
  @@index([userId, waktuMulai], map: "idx_jadwal_user_waktu")
  @@map("jadwal")
}

model Tugas {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  idJadwal   Int       @map("id_jadwal")
  namaTugas  String    @map("nama_tugas")
  deadline   DateTime  @db.Date
  prioritas  String
  jenis      String
  status     String    @default("Belum Dikerjakan")
  progress   Int       @default(0)
  isPinned   Boolean   @default(false) @map("is_pinned")
  reminderAt DateTime? @map("reminder_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jadwal     Jadwal    @relation(fields: [idJadwal], references: [id], onDelete: Cascade)

  @@index([userId, status, isPinned, deadline], map: "idx_tugas_user_status_pinned_deadline")
  @@index([userId, deadline], map: "idx_tugas_user_deadline")
  @@index([idJadwal], map: "idx_tugas_id_jadwal")
  @@map("tugas")
}

model Ujian {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  idJadwal     Int       @map("id_jadwal")
  jenisUjian   String    @map("jenis_ujian")
  tanggal      DateTime  @db.Date
  waktuMulai   DateTime? @map("waktu_mulai") @db.Time
  waktuSelesai DateTime? @map("waktu_selesai") @db.Time
  ruangan      String?
  catatan      String?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jadwal       Jadwal    @relation(fields: [idJadwal], references: [id], onDelete: Cascade)

  @@index([userId, tanggal, waktuMulai], map: "idx_ujian_user_tanggal_waktu")
  @@index([idJadwal], map: "idx_ujian_id_jadwal")
  @@map("ujian")
}

model KelasPengganti {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  idJadwal     Int      @map("id_jadwal")
  tanggal      DateTime @db.Date
  waktuMulai   DateTime @map("waktu_mulai") @db.Time
  waktuSelesai DateTime @map("waktu_selesai") @db.Time
  lokasi       String?
  catatan      String?
  status       String   @default("Belum Selesai")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jadwal       Jadwal   @relation(fields: [idJadwal], references: [id], onDelete: Cascade)

  @@index([userId, status, tanggal, waktuMulai], map: "idx_kelas_pengganti_user_status_tanggal")
  @@index([idJadwal], map: "idx_kelas_pengganti_id_jadwal")
  @@map("kelas_pengganti")
}

model Announcement {
  id        BigInt    @id @default(autoincrement())
  title     String
  content   String
  isActive  Boolean   @default(false) @map("is_active")
  createdAt DateTime? @default(now()) @map("created_at")

  @@index([isActive, createdAt], map: "idx_announcements_active_created")
  @@map("announcements")
}

model AdminLog {
  id                BigInt    @id @default(autoincrement())
  timestamp         DateTime? @default(now()) @map("timestamp")
  adminUsername     String    @map("admin_username")
  actionType        String    @map("action_type")
  actionDescription String    @map("action_description")

  @@map("admin_logs")
}

model SystemSetting {
  settingKey   String  @id @map("setting_key")
  settingValue String? @map("setting_value")

  @@map("settings")
}
